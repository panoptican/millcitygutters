[
  {
    "_comment": "Rules for scripts/truth_check.py. Any must_not_match hit is a finding. Add a rule every time a `correct` action fixes a live claim.",
    "claim": "Street address is the Minneapolis shop",
    "paths": ["index.html", "*.html"],
    "must_not_match": ["Minneapolis, MN 5540(?!7)\\d"],
    "must_match": ["5237 34th Avenue South", "Minneapolis, MN 55417"]
  },
  {
    "claim": "Phone number",
    "paths": ["index.html", "*.html"],
    "must_not_match": ["\\(651\\)", "\\(763\\)", "\\(952\\)"],
    "must_match": ["390-7483"]
  },
  {
    "claim": "No published per-foot price (none is documented in truth.md)",
    "paths": ["index.html", "*.html"],
    "must_not_match": ["our (rate|price) is \\$", "we charge \\$\\d", "starting at \\$\\d"],
    "must_match": []
  },
  {
    "claim": "We are a gutter contractor, not a roofing/siding/window company",
    "paths": ["index.html", "*.html"],
    "must_not_match": ["roof (replacement|repair|installation)", "siding (installation|replacement)", "window (installation|replacement)"],
    "must_match": []
  },
  {
    "claim": "Licensing/insurance claim is not documented in truth.md",
    "paths": ["index.html", "*.html"],
    "must_not_match": ["licensed and insured", "licensed, bonded", "fully licensed and insured", "fully insured"],
    "must_match": []
  },
  {
    "claim": "Warranty length is not documented in truth.md",
    "paths": ["index.html", "*.html"],
    "must_not_match": ["\\d+[- ]year warranty", "lifetime warranty", "lifetime guarantee"],
    "must_match": []
  }
]
